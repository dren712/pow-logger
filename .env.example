# PROVN Environment Configuration Template

# Supabase PostgreSQL Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Server-Side Irys Node 1 Operational Wallet Key (64-byte JSON Array or Base58 String)
IRYS_PRIVATE_KEY="[12, 34, 56, ...]"

# Optional Canonical Application Domain (Defaults to host header validation)
# NEXT_PUBLIC_APP_DOMAIN=provn-sol.vercel.app
# ALLOWED_DOMAINS=provn-sol.vercel.app,localhost:3000

# Optional Solana RPC URL Overrides
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-key

# Metaplex Compressed NFT (cNFT) Phase 2 Scaffolding & Feature Flags
# NEXT_PUBLIC_CNFT_ENABLED=false
# SOLANA_MERKLE_TREE_PUBKEY=your-merkle-tree-pubkey
