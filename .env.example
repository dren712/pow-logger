# PROVN Environment Configuration Template

# Supabase PostgreSQL Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Server-Side Irys Node 1 Operational Wallet Key (64-byte JSON Array or Base58 String)
IRYS_PRIVATE_KEY="[12, 34, 56, ...]"

# Optional Canonical Application Domain (Defaults to host header validation)
# NEXT_PUBLIC_APP_DOMAIN=provn-sol.vercel.app

# Optional Solana Merkle Tree Pubkey for Metaplex cNFT Minting
# SOLANA_MERKLE_TREE_PUBKEY=your-merkle-tree-pubkey
