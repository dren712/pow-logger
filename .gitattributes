# Explicit GitHub Linguist Configuration

# Core Languages
*.rs linguist-language=Rust
*.ts linguist-language=TypeScript
*.tsx linguist-language=TypeScript
*.css linguist-language=CSS

# Exclude documentation, tests, and scripts from language statistics
*.md linguist-documentation
docs/** linguist-documentation
tests/** linguist-documentation
scripts/** linguist-documentation
supabase/** linguist-documentation

# Exclude bundled and generated files
bin/** linguist-vendored
*.json linguist-generated
*.lock linguist-generated
